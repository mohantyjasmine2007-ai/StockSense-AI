# StockSense AI - Environment Configuration
APP_NAME=StockSense AI
APP_ENV=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Live Weather Integration (Free, no key required for Open-Meteo)
WEATHER_API_PROVIDER=open-meteo
ENABLE_LIVE_WEATHER=true
DEMO_DATA_DIR=data/demo
UPLOAD_DATA_DIR=data/uploads
